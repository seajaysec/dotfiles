#!/bin/sh
# iTerm session-log retention (daily via launchd: com.dotfiles.iterm-log-retention).
# Logs are full transcripts: keep them local, compress after a week (zgrep still
# searches them), delete after KEEP days. Age = last write, so a still-running
# session's log is never touched.
#
# KEEP, first match wins:
#   1. $ITERM_LOG_KEEP_DAYS (manual runs)
#   2. ~/.config/dotfiles/iterm-log-keep-days (machine-local, one integer;
#      launchd doesn't see shell env, so this is the per-machine knob)
#   3. 45 (a month plus a vacation)
set -eu
DIR="${ITERM_LOG_DIR:-$HOME/Library/Logs/iTerm2}"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/iterm-log-keep-days"
KEEP="${ITERM_LOG_KEEP_DAYS:-}"
[ -z "$KEEP" ] && [ -r "$CONF" ] && KEEP=$(tr -dc '0-9' < "$CONF")
KEEP="${KEEP:-45}"
[ -d "$DIR" ] || exit 0
[ "$KEEP" -gt 7 ] && find "$DIR" -type f -name '*.log' -mtime +7 -exec gzip -9 {} \;
find "$DIR" -type f \( -name '*.log' -o -name '*.log.gz' \) -mtime +"$KEEP" -delete
