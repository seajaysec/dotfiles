#!/usr/bin/env python3
"""Smart multi-line copy: un-hard-wrap the clipboard.

TUIs (Claude Code, vim, tmux, man pages) draw text with real newlines and
indentation, so copying a paragraph gives you broken lines. This rewrites the
clipboard in place: strips trailing spaces, removes the shared left indent,
and re-joins wrapped lines into paragraphs. Fenced ``` code blocks are kept
exactly as they are.

  unwrap-clipboard            # fix the clipboard in place (iTerm ⌘⌥C runs this)
  pbpaste | unwrap-clipboard --stdin

iTerm runs it as a coprocess, so it must never print to stdout.
"""
import re
import subprocess
import sys
import textwrap


# Lines that start their own thing: list items, headings, quotes, tables, prompts.
_STARTS_BLOCK = re.compile(r"^\s*([-*+•▪◦]\s|\d+[.)]\s|#{1,6}\s|>\s?|\||\$ |>>> |❯ )")
# Lines that look like code / commands rather than prose.
_CODEISH = re.compile(r"^\s*(def |class |import |from \S+ import|return\b|if .*:$|for .*:$|\w[\w.]*\(.*\)\s*$|[\w.-]+\s*=\s|[{}\[\]]\s*$)")


def should_join(prev: str, nxt: str, prev_len: int, width: int) -> bool:
    """Is `nxt` a wrapped continuation of `prev`?

    prev_len is the ORIGINAL length of the previous screen line (prev may
    already hold earlier joins); width is the longest line in the selection,
    i.e. roughly where the app wrapped.
    """
    if _STARTS_BLOCK.match(nxt) or _CODEISH.match(nxt) or _CODEISH.match(prev):
        return False
    tail = prev.rstrip()
    if tail.endswith((":", "\\", "{", "[", "(")):  # intro to a block, or code continuation
        return False
    # A wrapped line runs close to the wrap width; a short one ended on purpose.
    if width and prev_len < 0.6 * width:
        return False
    return True


def unwrap(text: str) -> str:
    lines = textwrap.dedent("\n".join(l.rstrip() for l in text.splitlines())).split("\n")
    width = max((len(l) for l in lines), default=0)
    out: list[str] = []
    in_fence = False
    last_len = 0
    for line in lines:
        fence = line.lstrip().startswith("```")
        if fence:
            in_fence = not in_fence
        if (not fence and not in_fence and out and out[-1].strip() and line.strip()
                and not out[-1].lstrip().startswith("```")
                and should_join(out[-1], line, last_len, width)):
            out[-1] = out[-1] + " " + line.strip()
        else:
            out.append(line)
        last_len = len(line)
    return "\n".join(out).strip("\n")


def main() -> None:
    if "--stdin" in sys.argv:
        sys.stdout.write(unwrap(sys.stdin.read()) + "\n")
        return
    text = subprocess.run(["pbpaste"], capture_output=True, text=True).stdout
    if text.strip():
        subprocess.run(["pbcopy"], input=unwrap(text), text=True)


if __name__ == "__main__":
    main()
