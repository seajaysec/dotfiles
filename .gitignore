.DS_Store

# Machine-only / secrets (never commit even if copied into repo by mistake)
secrets.sh
.env
.env.*
.claude
.claude/

# Machine-specific Brewfile snapshots (named with hostname / asset tag)
Brewfile.*
!Brewfile.template

# iTerm2 binary state exports (large, contain session metadata)
*.itermexport

# Cursor IDE workspace cache (transcripts, hook state, plans)
.cursor/

# gpakosz/.tmux backup files left by the pivot away from -CC
*.gpakosz.bak
